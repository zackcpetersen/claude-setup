#!/usr/bin/env bash
# PreToolUse hook for the Agent tool: on sessions running an expensive model,
# deny subagent dispatches that omit `model` when the agent definition has no
# model pin. Unpinned dispatches silently inherit the session model.
#
# Wire-up ships with the model-discipline plugin (hooks/hooks.json); nothing
# needs to be pasted into settings.json.
# Set CLAUDE_EXPENSIVE_MODEL_PREFIX to match whichever model your top tier is
# (default: claude-fable).
# This hook must never brick dispatching: every error path exits 0 (allow).

set -u

allow() { exit 0; }

command -v jq >/dev/null 2>&1 || allow

input=$(cat) || allow

subagent_type=$(printf %s "$input" | jq -r '.tool_input.subagent_type // empty' 2>/dev/null) || allow
model=$(printf %s "$input" | jq -r '.tool_input.model // empty' 2>/dev/null) || allow
transcript=$(printf %s "$input" | jq -r '.transcript_path // empty' 2>/dev/null) || allow

# Explicit model given: fine.
[[ -n "$model" ]] && allow

# Forks always run on the parent model and ignore overrides; requiring a
# model here would teach a false rule.
[[ "$subagent_type" == "fork" ]] && allow

# Only police expensive sessions. On cheaper sessions, omitting `model` is
# harmless inheritance. Fail open if the transcript can't be read.
prefix="${CLAUDE_EXPENSIVE_MODEL_PREFIX:-claude-fable}"
[[ -z "$transcript" || ! -r "$transcript" ]] && allow
session_model=$(tail -200 "$transcript" 2>/dev/null \
  | jq -rs '[.[] | select(.type == "assistant") | .message.model // empty] | last // empty' 2>/dev/null) || allow
[[ "$session_model" == "$prefix"* ]] || allow

# Namespaced plugin agent types (contain ":") can't be resolved by path;
# pass them through rather than guess.
[[ "$subagent_type" == *:* ]] && allow

# Pinned agent definitions are authoritative; an explicit model arg would
# OVERRIDE the pin, so omitting it there is correct.
for dir in "${CLAUDE_PROJECT_DIR:-}" "$HOME/.claude"; do
  [[ -n "$dir" && -f "$dir/.claude/agents/$subagent_type.md" ]] \
    && grep -q '^model:' "$dir/.claude/agents/$subagent_type.md" 2>/dev/null && allow
  [[ -n "$dir" && -f "$dir/agents/$subagent_type.md" ]] \
    && grep -q '^model:' "$dir/agents/$subagent_type.md" 2>/dev/null && allow
done

# Built-in types (general-purpose, Explore, Plan, claude, absent) and
# unpinned custom agents land here: deny with guidance.
cat <<'JSON'
{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Pass an explicit model (sonnet=mechanical, opus=complex/review) - unpinned dispatches inherit the session model. Omit model only for agents whose definition pins one."}}
JSON
exit 0
