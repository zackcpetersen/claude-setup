#!/usr/bin/env python3
"""wait-for: one background wait that prints one event line and exits.

Modes: pr, deploy, dagster, slack. Poll, print one event line, exit 0. Exit 2 on a
usage or config error. Standard library only. See skills/watch/SKILL.md.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

CONFIG_BOUNDARY = "## (file boundary)"  # put between config files, so a section never runs across files
DEFAULT_EVERY = "5m"
DEFAULT_MAX = {"pr": "3d", "deploy": "4h", "dagster": "12h", "slack": "12h"}
MAX_ERRORS = 3
MIN_EVERY = timedelta(seconds=10)
CMD_TIMEOUT = 60
CHECK_FAILED = {"FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"}
CONTEXT_FAILED = {"FAILURE", "ERROR"}
CONTEXT_PENDING = {"PENDING", "EXPECTED"}
PR_FIELDS = "state,headRefOid,reviewDecision,statusCheckRollup,mergeStateStatus,mergeCommit"
WORKFLOW_COMPARES = 5
WORKFLOW_COUNTED = {"success", "failure", "timed_out"}  # cancelled, skipped and the rest are passed over
RELEASE_GRACE = timedelta(minutes=5)  # time GitHub gets to start the runs a published release triggers
RELEASE_RUN_OK = {"success", "skipped", "neutral"}
DAGSTER_TERMINAL = {"SUCCESS", "FAILURE", "CANCELED"}
RUN_QUERY = 'query($id:ID!){runOrError(runId:$id){__typename ... on Run{runId status}}}'
SLACK_TIMEOUT = 180
SLACK_OVERLAP = 60  # seconds re-searched before the cursor, so a late-indexed message is not missed
SLACK_FIRST_LOOKBACK = timedelta(minutes=15)
SLACK_SEEN_CAP = 500
SLACK_TEXT_CAP = 500
SLACK_BUDGET_USD = "0.25"  # hard cap per poll run
SLACK_STATE_FILE = "~/.claude/slack-poll.json"
SLACK_TRIGGERS = ("mentions", "dms", "group-dms", "user-groups", "thread-replies", "keywords")
SLACK_DEFAULT_TRIGGERS = ("mentions", "dms", "group-dms", "user-groups", "thread-replies")
SLACK_GROUP_DM_MODES = ("aimed-only", "all")
SLACK_GROUP_DM_LOOKBACK = "60m"  # the user posted in a group DM this recently: they are in the conversation
SLACK_HELD_KEEP = timedelta(days=14)  # held group DM lines older than this are dropped on the next append
SLACK_HELD_TAIL = 200  # lines checked for a duplicate key before appending
SLACK_QUIET_HINTS = ("ack", "bot", "fyi")  # hints the `Slack poll quiet` line may list; default is none of them
SLACK_NEVER_QUIET = ("dm", "mention")  # a DM or a direct mention always wakes, whatever its hint
SLACK_KIND_ORDER = ("dm", "mention", "user-group", "thread-reply", "keyword", "channel", "group-dm")  # first wins
SLACK_CHANNEL_THREAD_LOOKBACK = timedelta(hours=24)  # watched channels: parents this old are read for new replies
_warned = set()
SLACK_READ_TOOLS = ("slack_search_public_and_private", "slack_search_public", "slack_read_thread", "slack_read_channel",
                    "slack_read_user_profile", "slack_search_users", "slack_search_channels")
SLACK_WRITE_TOOLS = ("slack_send_message", "slack_send_message_draft", "slack_schedule_message", "slack_add_reaction",
                     "slack_create_canvas", "slack_update_canvas", "slack_create_conversation", "slack_create_list",
                     "slack_update_list", "slack_add_list_record", "slack_update_list_record",
                     "slack_get_file_upload_url", "slack_complete_file_upload")
SLACK_PROMPT = Path(os.path.realpath(__file__)).parent.parent / "skills" / "watch" / "slack-poll.md"
SLACK_PROMPT_FALLBACK = "~/.claude/skills/watch/slack-poll.md"
PLUGIN_CACHE = "~/.claude/plugins/cache"
USER_SETTINGS = ("~/.claude/settings.json", "~/.claude/settings.local.json")
BACKFILL_QUERY = (
    'query($id:String!){partitionBackfillOrError(backfillId:$id){__typename ... on PartitionBackfill'
    '{id status numPartitions partitionStatuses{results{partitionName runId runStatus}}} ... on PythonError{message}}}'
)

SLEEP = time.sleep
CLOCK = time.monotonic
NOW = lambda: datetime.now(timezone.utc)


class StopWait(Exception):
    """A problem a retry cannot fix. The wait prints one ERROR line and exits so the session hears about it."""


class WaitError(Exception):
    """A usage or config problem. Exit 2."""


# ---------- config ----------

def parse_duration(text):
    m = re.fullmatch(r"\s*(\d+)\s*([smhd])\s*", str(text))
    if not m:
        raise WaitError(f"bad duration {text!r}, expected a number and s, m, h or d (like 5m)")
    n, unit = int(m.group(1)), m.group(2)
    return {"s": timedelta(seconds=n), "m": timedelta(minutes=n), "h": timedelta(hours=n), "d": timedelta(days=n)}[unit]


def parse_deploy_rule(text):
    words = str(text).split()
    if len(words) == 4 and words[0] == "workflow" and words[2] == "on":
        return {"type": "workflow", "name": words[1], "branch": words[3]}
    if words == ["release-tag"]:
        return {"type": "release-tag"}
    if len(words) == 2 and words[0] == "branch":
        return {"type": "branch", "name": words[1]}
    raise WaitError(
        f"bad deploy rule {text!r}, expected `workflow <name> on <branch>`, `release-tag` or `branch <name>`"
    )


def _is_unset(value):
    return value == "" or (value.startswith("<") and value.endswith(">"))


def _has_placeholder(value):
    return bool(re.search(r"<[^<>]*>", value))


def _where(src, name):
    """Where a section was read from, for error messages."""
    return f"of {src}" if src else f"(~/.claude/config/{name}.md or ~/.claude/CLAUDE.md)"


def _field(value, line, path):
    """Unwrap one `<...>` field. A field that still holds `<` or `>` is an unfilled template placeholder."""
    value = value.strip()
    if len(value) >= 2 and value.startswith("<") and value.endswith(">"):
        value = value[1:-1].strip()
    if "<" in value or ">" in value or not value:
        raise WaitError(
            f"the `{line}` line in the ### Watches section {_where(path, 'watch')} still has a template placeholder "
            f"({value!r}); fill it in or delete the line"
        )
    return value


def _clean(value):
    value = value.strip()
    if len(value) >= 2 and value.startswith("`") and value.endswith("`"):
        value = value[1:-1].strip()
    return value


def _read_section(lines, heading):
    """Return ({key: value}, {repo: rule text}) for the `### <heading>` section."""
    values, nested = {}, {}
    inside, last_key = False, None
    for raw in lines:
        if raw.startswith("##"):
            inside = raw.startswith("### " + heading)
            last_key = None
            continue
        if not inside:
            continue
        line = re.sub(r"<!--.*?-->", "", raw).rstrip()
        top = re.match(r"^- ([^:]+?):\s*(.*)$", line)
        if top:
            last_key = top.group(1).strip()
            value = _clean(top.group(2))
            if value and (last_key in ("Dagster", "Connectors") or not _is_unset(value)):
                if _has_placeholder(value) and last_key in values and not _has_placeholder(values[last_key]):
                    continue  # a placeholder never hides a real value read earlier
                values[last_key] = value
            continue
        sub = re.match(r"^\s+- ([^:]+?):\s*(.*)$", line)
        if sub and last_key == "Deploy rules":
            repo, rule = _clean(sub.group(1)), _clean(sub.group(2))
            if not _is_unset(repo) and not _is_unset(rule):
                nested[repo] = rule
    return values, nested


def _expand(path):
    return str(Path(path).expanduser())


def config_lines(path_arg):
    """Return (lines, explicit path or None).

    `--config` or WAIT_FOR_CONFIG names one file, read alone. Otherwise read ~/.claude/CLAUDE.md, then each
    ~/.claude/config/*.md in name order, with a boundary heading before each file. Missing files are skipped.
    _read_section keeps the last real value per key, so a value in ~/.claude/config/ wins over CLAUDE.md.
    """
    explicit = path_arg or os.environ.get("WAIT_FOR_CONFIG")
    if explicit:
        path = Path(explicit).expanduser()
        try:
            return path.read_text().splitlines(), path
        except OSError as e:
            raise WaitError(f"cannot read config {path}: {e.strerror}")
    home = Path.home() / ".claude"
    lines, read = [], 0
    for f in [home / "CLAUDE.md"] + sorted((home / "config").glob("*.md")):
        try:
            text = f.read_text()
        except OSError:
            continue
        lines += [CONFIG_BOUNDARY] + text.splitlines()
        read += 1
    if not read:
        raise WaitError(f"cannot read config: no {home / 'CLAUDE.md'} and no {home / 'config'}/*.md")
    return lines, None


def load_config(path=None):
    """Read the kept lines of the `### Watches` section: Dagster and Deploy rules."""
    lines, path = config_lines(path)
    watches, rules = _read_section(lines, "Watches")

    dagster = None
    if "Dagster" in watches:
        m = re.fullmatch(r"(\S+),\s*env file\s+(\S+),\s*token var\s+(\S+)", watches["Dagster"])
        if not m:
            raise WaitError(f"bad Dagster line {watches['Dagster']!r}, expected `<url>, env file <path>, token var <NAME>`")
        url, env_file, token_var = (_field(m.group(i), "Dagster", path) for i in (1, 2, 3))
        dagster = {"url": url, "env_file": _expand(env_file), "token_var": token_var}

    return {"dagster": dagster, "deploy_rules": {repo: parse_deploy_rule(rule) for repo, rule in rules.items()}}


def _split_list(text):
    return [w.strip() for w in re.split(r"[,\n]", text or "") if w.strip()]


def load_slack_config(path=None):
    """Read the `Slack poll` lines of `### Watches` and the Slack user id from `### Work board`."""
    lines, path = config_lines(path)
    watches, _ = _read_section(lines, "Watches")
    board, _ = _read_section(lines, "Work board")
    if watches.get("Slack poll", "").lower() != "on":
        raise WaitError(f"Slack poll is not on; set `- Slack poll: on` in the ### Watches section {_where(path, 'watch')}")
    user = board.get("Slack user id", "")
    if not re.fullmatch(r"[UW][A-Z0-9]{2,}", user):
        raise WaitError(f"no Slack user id in the ### Work board section {_where(path, 'board')}")
    conn = re.search(r"slack\s+(\S+)", watches.get("Connectors", ""))
    if not conn or _is_unset(conn.group(1)):
        raise WaitError(f"no slack prefix on the Connectors line in the ### Watches section {_where(path, 'watch')}")
    triggers = [t.lower() for t in _split_list(watches.get("Slack poll triggers"))] or list(SLACK_DEFAULT_TRIGGERS)
    bad = [t for t in triggers if t not in SLACK_TRIGGERS]
    if bad:
        raise WaitError(f"unknown Slack poll trigger {', '.join(bad)}; known: {', '.join(SLACK_TRIGGERS)}")
    keywords = _split_list(watches.get("Slack poll keywords"))
    if "keywords" in triggers and not keywords:
        raise WaitError("the keywords trigger is on but the `Slack poll keywords` line is empty")
    group_dms = watches.get("Slack poll group-dms", "").lower() or "aimed-only"
    if group_dms not in SLACK_GROUP_DM_MODES:
        raise WaitError(f"unknown `Slack poll group-dms` value {group_dms}; known: {', '.join(SLACK_GROUP_DM_MODES)}")
    name = watches.get("Slack poll user name", "")
    lookback = parse_duration(watches.get("Slack poll group-dms lookback") or SLACK_GROUP_DM_LOOKBACK)
    quiet_line = watches.get("Slack poll quiet")
    channels = watches.get("Slack poll channels", "")
    quiet = [] if (quiet_line or "").lower() == "none" else (
        [w.lower() for w in _split_list(quiet_line)] if quiet_line else [])
    bad = [w for w in quiet if w not in SLACK_QUIET_HINTS]
    if bad:
        raise WaitError(f"unknown `Slack poll quiet` word {', '.join(bad)}; known: {', '.join(SLACK_QUIET_HINTS)}, or none")
    return {
        "user": user,
        "prefix": conn.group(1),
        "every": watches.get("Slack poll every"),
        "model": watches.get("Slack poll model", "haiku"),
        "triggers": triggers,
        "groups": _split_list(watches.get("Slack poll user groups")),
        "keywords": keywords,
        "ignore": _split_list(watches.get("Slack poll ignore")),
        "state_file": _expand(watches.get("Slack poll state file", SLACK_STATE_FILE)),
        "group_dms": group_dms,
        "user_name": "" if _is_unset(name) else name.split()[0],
        "group_dm_lookback": lookback,
        "quiet": quiet,
        "channels": [c for c in _split_list(channels) if not _is_unset(c)] if not _is_unset(channels) else [],
    }


# ---------- helpers ----------

def run_cmd(args):
    return subprocess.run(args, capture_output=True, text=True, timeout=CMD_TIMEOUT, check=True).stdout


def gql(url, token, query, variables):
    """POST one Dagster GraphQL query and return its data. The token goes in a header only."""
    req = urllib.request.Request(
        url,
        data=json.dumps({"query": query, "variables": variables}).encode(),
        headers={"Content-Type": "application/json", "Dagster-Cloud-Api-Token": token},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=CMD_TIMEOUT) as resp:
        body = json.loads(resp.read())
    if body.get("errors"):
        raise RuntimeError("GraphQL error: " + "; ".join(str(e.get("message", e)) for e in body["errors"]))
    return body["data"]


def load_env_file(path):
    """Set KEY=VALUE lines from an env file that are not already in the environment."""
    try:
        text = Path(path).read_text()
    except FileNotFoundError:
        return
    except OSError as e:
        raise WaitError(f"cannot read env file {path}: {e.strerror}")
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        key, sep, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if not sep or not re.fullmatch(r"[A-Za-z_]\w*", key):
            continue
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        else:
            value = re.sub(r"\s+#.*$", "", value)
        os.environ.setdefault(key, value)


def _check_failed(c):
    return c.get("conclusion") in CHECK_FAILED or c.get("state") in CONTEXT_FAILED


def rollup_state(rollup, merge_state):
    if not rollup:
        return "green" if merge_state == "CLEAN" else "pending"
    if any(_check_failed(c) for c in rollup):
        return "failed"
    for c in rollup:
        if "state" in c:
            if c["state"] in CONTEXT_PENDING:
                return "pending"
        elif c.get("status") != "COMPLETED":
            return "pending"
    return "green"


def any_pending(rollup):
    """True while any check is still queued or running, failed or not."""
    for c in rollup or []:
        if "state" in c:
            if c["state"] in CONTEXT_PENDING:
                return True
        elif c.get("status") != "COMPLETED":
            return True
    return False


def failed_names(rollup):
    return [c.get("name") or c.get("context") or "unknown" for c in rollup or [] if _check_failed(c)]


def run_claude(args, cwd):
    """One headless Claude run. stdin is /dev/null so it never waits for input."""
    return subprocess.run(args, capture_output=True, text=True, timeout=SLACK_TIMEOUT, check=True, cwd=cwd,
                          stdin=subprocess.DEVNULL).stdout


def write_json(path, data):
    """Write atomically: a temp file in the same folder, then rename."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)


def contains(repo, sha, ref):
    status = run_cmd(["gh", "api", f"repos/{repo}/compare/{sha}...{ref}", "--jq", ".status"]).strip()
    return status in ("identical", "ahead")


BACKFILL_DONE_OK = {"COMPLETED", "COMPLETED_SUCCESS"}
BACKFILL_DONE = BACKFILL_DONE_OK | {"COMPLETED_FAILED", "FAILED", "CANCELED", "CANCELLED"}


def backfill_state(b):
    if b.get("__typename") != "PartitionBackfill":
        return "UNKNOWN"
    status = b.get("status")
    results = (b.get("partitionStatuses") or {}).get("results") or []
    statuses = [r.get("runStatus") for r in results]
    if not results:  # nothing to tally, so the backfill's own status decides
        if status not in BACKFILL_DONE:
            return "RUNNING"
        return "SUCCESS" if status in BACKFILL_DONE_OK else "FAILURE"
    if any(s is not None and s not in DAGSTER_TERMINAL for s in statuses):
        return "RUNNING"
    if status in BACKFILL_DONE:
        failed = status not in BACKFILL_DONE_OK or any(s in ("FAILURE", "CANCELED") for s in statuses)
        return "FAILURE" if failed else "SUCCESS"
    if len(results) < (b.get("numPartitions") or 0) or any(s is None for s in statuses):
        return "RUNNING"
    return "SUCCESS" if all(s == "SUCCESS" for s in statuses) else "FAILURE"


# ---------- polls: each returns an event line, or None to keep waiting ----------

def required_failures(repo, number):
    """Names of failed or cancelled required checks. No required checks at all is not an error."""
    try:
        out = run_cmd(["gh", "pr", "checks", str(number), "--repo", repo, "--required", "--json", "name,bucket"])
    except subprocess.CalledProcessError as e:
        if "no required checks" in (e.stderr or "").lower():
            return []
        raise
    return [c.get("name") or "unknown" for c in json.loads(out or "[]") if c.get("bucket") in ("fail", "cancel")]


def poll_pr(repo, number, sha=None):
    view = json.loads(run_cmd(["gh", "pr", "view", str(number), "--repo", repo, "--json", PR_FIELDS]))
    state, head = view.get("state"), view.get("headRefOid") or ""
    merge_state, review = view.get("mergeStateStatus"), view.get("reviewDecision") or ""
    rollup = view.get("statusCheckRollup") or []
    checks = rollup_state(rollup, merge_state)
    if state == "MERGED":
        merge_sha = (view.get("mergeCommit") or {}).get("oid")
        return f"MERGED {number} {merge_sha}" if merge_sha else None  # the merge commit can lag the state
    if state == "CLOSED":
        return f"CLOSED {number}"
    if checks == "failed":
        names = required_failures(repo, number)  # optional failures never fail the wait
        if names:
            return f"FAILED {number} {','.join(names)}"
    if review == "CHANGES_REQUESTED":
        return f"CHANGES_REQUESTED {number}"
    if sha and head != sha:
        return f"HEAD_MOVED {number} {head}"
    if merge_state == "DIRTY":
        return f"CONFLICT {number}"
    if merge_state == "BEHIND":
        return f"BEHIND {number}"
    if state == "OPEN" and merge_state in ("CLEAN", "UNSTABLE", "HAS_HOOKS") and review in ("APPROVED", "") and checks != "pending" \
            and not any_pending(rollup):
        line = f"READY {number} {head} {'approved' if review == 'APPROVED' else 'no-review-required'}"
        optional = failed_names(rollup)
        return line + (" optional-failed=" + ",".join(optional) if optional else "")
    return None


def poll_deploy(repo, sha, rule):
    if rule["type"] == "branch":
        head = run_cmd(["gh", "api", f"repos/{repo}/branches/{rule['name']}", "--jq", ".commit.sha"]).strip()
        return f"DEPLOYED {sha} {head}" if contains(repo, sha, head) else None
    if rule["type"] == "release-tag":
        return poll_release(repo, sha)
    runs = json.loads(run_cmd([
        "gh", "run", "list", "--repo", repo, "--workflow", rule["name"], "--branch", rule["branch"],
        "--json", "databaseId,headSha,status,conclusion", "--limit", "20",
    ]))
    counted = [r for r in runs if r.get("status") == "completed" and r.get("conclusion") in WORKFLOW_COUNTED]
    for r in counted[:WORKFLOW_COMPARES]:
        if contains(repo, sha, r["headSha"]):
            word = "DEPLOYED" if r["conclusion"] == "success" else "DEPLOY_FAILED"
            return f"{word} {sha} {r['databaseId']}"
    return None


def _parse_time(text):
    return datetime.fromisoformat(text.replace("Z", "+00:00"))


def poll_release(repo, sha):
    """The latest release must contain the sha, then every run its publish triggered must finish green."""
    release = json.loads(run_cmd(["gh", "api", f"repos/{repo}/releases/latest", "--jq", "{tag: .tag_name, at: .published_at}"]))
    tag = release["tag"]
    if not contains(repo, sha, tag):
        return None
    tag_sha = run_cmd(["gh", "api", f"repos/{repo}/commits/{tag}", "--jq", ".sha"]).strip()
    runs = json.loads(run_cmd([
        "gh", "api", f"repos/{repo}/actions/runs?event=release&head_sha={tag_sha}&per_page=100",
        "--jq", "[.workflow_runs[] | {id, name, status, conclusion, created_at}]",
    ]))
    published = _parse_time(release["at"])
    runs = [r for r in runs if _parse_time(r["created_at"]) >= published - timedelta(minutes=1)]  # skip older releases of this commit
    if not runs:
        return f"DEPLOYED {sha} {tag} no-release-runs" if NOW() - published >= RELEASE_GRACE else None
    newest = {}
    for r in sorted(runs, key=lambda r: r["id"]):  # a re-run of a workflow replaces its earlier run
        newest[r["name"]] = r
    if any(r["status"] != "completed" for r in newest.values()):
        return None
    failed = [name for name, r in newest.items() if r["conclusion"] not in RELEASE_RUN_OK]
    return f"DEPLOY_FAILED {sha} {tag} {','.join(failed)}" if failed else f"DEPLOYED {sha} {tag}"


def poll_dagster(kind, ident, dagster, token):
    if kind == "run":
        run = gql(dagster["url"], token, RUN_QUERY, {"id": ident})["runOrError"]
        if run.get("__typename") != "Run":
            raise RuntimeError(f"run {ident}: {run.get('__typename')}")
        status = run["status"]
    else:
        payload = gql(dagster["url"], token, BACKFILL_QUERY, {"id": ident})["partitionBackfillOrError"]
        status = backfill_state(payload)
        if status == "UNKNOWN":
            raise RuntimeError(f"backfill {ident}: {payload.get('__typename')} {payload.get('message') or ''}".strip())
    if status == "SUCCESS":
        return "SUCCEEDED"
    if status in ("FAILURE", "CANCELED"):
        return f"FAILED {status}"
    return None


# ---------- slack ----------

def slack_prompt_template():
    for p in (SLACK_PROMPT, Path(SLACK_PROMPT_FALLBACK).expanduser()):
        try:
            text = Path(p).read_text()
        except OSError:
            continue
        m = re.search(r"^```text\n(.*?)^```", text, re.S | re.M)
        if m:
            return m.group(1)
    raise WaitError(f"cannot find the prompt block in {SLACK_PROMPT} or {SLACK_PROMPT_FALLBACK}")


def fill(template, values):
    return re.sub(r"\{\{(\w+)\}\}", lambda m: str(values.get(m.group(1), m.group(0))), template)


def other_allowed_tools(read_tools):
    """MCP tools the user's settings allow outright, other than the Slack read tools. The poll denies them all."""
    found = []
    for f in USER_SETTINGS:
        try:
            allow = json.loads(Path(f).expanduser().read_text()).get("permissions", {}).get("allow", [])
        except (OSError, ValueError, AttributeError):
            continue
        found += [a for a in allow if isinstance(a, str) and a.startswith("mcp__") and a not in read_tools]
    return sorted(set(found))


def _tool_part(name):
    return re.sub(r"[^A-Za-z0-9]", "_", name)


def slack_mcp_config(prefix):
    """The Slack server's entry from its plugin's .mcp.json, as an --mcp-config string, or None.

    Loading only this one server keeps the run small: with every MCP server's tools riding along on each turn a poll
    costs about twenty times more, so a missing plugin stops the poll instead (see slack_command).
    """
    best = None
    for f in Path(PLUGIN_CACHE).expanduser().glob("*/*/*/.mcp.json"):
        plugin = f.parent.parent.name
        try:
            data = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        servers = data.get("mcpServers", data) if isinstance(data, dict) else {}
        for name, server in servers.items():
            if isinstance(server, dict) and f"mcp__plugin_{_tool_part(plugin)}_{_tool_part(name)}__" == prefix:
                mtime = f.stat().st_mtime
                if best is None or mtime > best[0]:
                    best = (mtime, f"plugin:{plugin}:{name}", server)
    return json.dumps({"mcpServers": {best[1]: best[2]}}) if best else None


def slack_command(cfg, prompt):
    read = [cfg["prefix"] + t for t in SLACK_READ_TOOLS]
    deny = [cfg["prefix"] + t for t in SLACK_WRITE_TOOLS] + other_allowed_tools(read)
    cmd = ["claude", "-p", prompt, "--model", cfg["model"], "--tools", "", "--permission-mode", "dontAsk",
           "--disable-slash-commands", "--allowedTools", ",".join(read), "--disallowedTools", ",".join(deny),
           "--max-budget-usd", SLACK_BUDGET_USD, "--output-format", "json", "--no-session-persistence"]
    mcp = slack_mcp_config(cfg["prefix"])
    if not mcp:
        raise StopWait(f"slack plugin-missing: no installed plugin provides {cfg['prefix']} (the Connectors line); "
                       "install or sign in to the Slack plugin, then start the poll again")
    return cmd + ["--strict-mcp-config", "--mcp-config", mcp]


def parse_claude(stdout):
    """Return (answer text, cost) from `--output-format json`: a list of events, or one result object."""
    data = json.loads(stdout)
    items = data if isinstance(data, list) else [data]
    result = next((e for e in items if isinstance(e, dict) and e.get("type") == "result"), None)
    if result is None:
        raise RuntimeError("no result event in the claude output")
    if result.get("is_error"):
        raise RuntimeError(f"claude run failed: {result.get('subtype')} {str(result.get('result') or '')[:200]}".strip())
    return result.get("result") or "", result.get("total_cost_usd")


def _answer_object(answer):
    """Take the text from the first `{` to the last `}` as one JSON object."""
    start, end = answer.find("{"), answer.rfind("}")
    if start < 0 or end < start:
        raise RuntimeError("the poll answer has no JSON object")
    data = json.loads(answer[start:end + 1])
    if not isinstance(data, dict):
        raise RuntimeError("the poll answer is not a JSON object")
    return data


def parse_events(data):
    """Read the `events` list of the parsed poll answer."""
    events = data.get("events")
    if not isinstance(events, list):
        raise RuntimeError("the poll answer has no events list")
    return [e for e in events if isinstance(e, dict) and e.get("channel_id") and e.get("ts")]


def parse_extras(data):
    """The optional keys next to `events`: group DM ids the user posted in lately, and the user's first name.

    A missing or malformed key reads as empty, so an answer in the older format still works.
    """
    active = data.get("user_active_mpims")
    active = {str(c) for c in active if c} if isinstance(active, list) else set()
    name = data.get("user_first_name")
    name = name.split()[0] if isinstance(name, str) and name.split() else ""
    return active, name


def valid_name(name):
    """A first name worth matching: one alphabetic word of 2 or more letters."""
    return bool(re.fullmatch(r"[^\W\d_]{2,}", name or ""))


def warn_once(key, text):
    if key not in _warned:
        _warned.add(key)
        print(f"WARN {text}", file=sys.stderr)


def aimed_at_user(event, cfg, name, active):
    """True when a group DM message should reach the user, False when it is chatter to hold back."""
    text = str(event.get("text") or "")
    words = ([name] if name else []) + (cfg["keywords"] if "keywords" in cfg["triggers"] else [])
    return (f"<@{cfg['user']}>" in text
            or any(re.search(rf"(?<!\w){re.escape(w)}(?!\w)", text, re.I) for w in words)
            or event.get("channel_id") in active)


def quiet_event(event, cfg):
    """True when the event's hint is on the `Slack poll quiet` line and its kind may be quieted.

    A missing or unknown hint wakes. DMs and direct mentions always wake. In a watched channel only a bot post
    may be quiet: a human message there always wakes, whatever kind it came back as (thread-reply, keyword...).
    """
    hint, kind = str(event.get("hint") or "").lower(), event.get("kind")
    if hint not in cfg.get("quiet", ()) or kind in SLACK_NEVER_QUIET:
        return False
    watched = {c.lstrip("#").lower() for c in cfg.get("channels") or ()}
    names = {str(event.get(k) or "").lstrip("#").lower() for k in ("channel_id", "channel_name")}
    return hint == "bot" or (kind != "channel" and not names & watched)


def dedupe_events(events):
    """One event per message: when a message comes back under more than one kind, keep the kind that comes
    first in SLACK_KIND_ORDER, at the place the message first showed up."""
    rank = {k: i for i, k in enumerate(SLACK_KIND_ORDER)}
    best = {}
    for e in events:
        key = f"{e['channel_id']}:{e['ts']}"
        if key not in best or rank.get(e.get("kind"), len(rank)) < rank.get(best[key].get("kind"), len(rank)):
            best[key] = e
    return list(best.values())


def held_path(state_file):
    state_file = Path(state_file)
    return state_file.with_name(state_file.stem + "-held.jsonl")


def digest_path(state_file):
    state_file = Path(state_file)
    return state_file.with_name(state_file.stem + "-digest.jsonl")


def append_held(path, events, now, stamp="held_at"):
    """Add events to a JSONL file (held or digest), once each, with a `stamp` time, and drop lines older than
    SLACK_HELD_KEEP. Atomic rewrite."""
    path = Path(path)
    cutoff = (now - SLACK_HELD_KEEP).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        old = path.read_text().splitlines()
    except FileNotFoundError:
        old = []
    kept = []
    for line in old:
        try:
            item = json.loads(line)
        except ValueError:
            continue
        if isinstance(item, dict) and str(item.get(stamp) or "") >= cutoff:
            kept.append(item)
    tail = {f"{h.get('channel_id')}:{h.get('ts')}" for h in kept[-SLACK_HELD_TAIL:]}
    at = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    for e in events:
        if f"{e['channel_id']}:{e['ts']}" not in tail:
            kept.append({**e, stamp: at})
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text("".join(json.dumps(h) + "\n" for h in kept))
    os.replace(tmp, path)


def load_state(path):
    try:
        state = json.loads(Path(path).read_text())
    except FileNotFoundError:
        return {"cursor": None, "seen": [], "user_name": ""}
    except (OSError, ValueError) as e:
        raise WaitError(f"cannot read the Slack poll state file {path}: {e}")
    return {"cursor": state.get("cursor"), "seen": list(state.get("seen") or []),
            "user_name": str(state.get("user_name") or "")}


def poll_slack(cfg, since=None):
    """One poll. Returns `SLACK <n> <file>` when there are new events, else None. Saves the cursor either way."""
    state_file = Path(cfg["state_file"])
    events_dir = state_file.with_name(state_file.stem + "-events")
    events_dir.mkdir(parents=True, exist_ok=True)
    state = load_state(state_file)
    started = NOW()
    if since is not None:
        after = started - since
    elif state["cursor"]:
        after = datetime.fromtimestamp(float(state["cursor"]) - SLACK_OVERLAP, timezone.utc)
    else:
        after = started - SLACK_FIRST_LOOKBACK
    filtering = "group-dms" in cfg["triggers"] and cfg["group_dms"] == "aimed-only"
    cached = state["user_name"] if valid_name(state["user_name"]) else ""
    name = cfg["user_name"] or cached
    # cover the whole search window, so an older message is judged against the hour before it too
    active_after = min(after, started) - cfg["group_dm_lookback"]
    triggers = list(cfg["triggers"])
    if filtering and "thread-replies" not in triggers:
        triggers.append("thread-replies-mpim")  # rule 2 needs thread replies in group DMs even with the trigger off
    prompt = fill(slack_prompt_template(), {
        "slack_user_id": cfg["user"],
        "after": str(int(after.timestamp())),
        "after_iso": after.strftime("%Y-%m-%d %H:%M UTC"),
        "triggers": ", ".join(triggers),
        "user_groups": ", ".join(cfg["groups"]) or "none",
        "keywords": ", ".join(cfg["keywords"]) or "none",
        "ignore": ", ".join(cfg["ignore"]) or "none",
        "active_after": str(int(active_after.timestamp())) if filtering else "none",
        "user_name": (name or "look up") if filtering else "not needed",
        "channels": ", ".join(cfg.get("channels") or ()) or "none",
        "channel_oldest": str(int((after - SLACK_CHANNEL_THREAD_LOOKBACK).timestamp())),
    })
    answer, cost = parse_claude(run_claude(slack_command(cfg, prompt), str(events_dir)))
    seen = set(state["seen"])
    ignore = {i.lstrip("#@").lower() for i in cfg["ignore"]}
    data = _answer_object(answer)
    active, found_name = parse_extras(data)
    if filtering and not name:
        if valid_name(found_name):
            name = cached = found_name
        else:
            warn_once("user-name", "slack user-name: could not read your first name from your Slack profile, so group "
                      "DM messages are not matched by name; set `Slack poll user name:` in the ### Watches section")
    fresh, held, quiet = [], [], []
    for e in dedupe_events(parse_events(data)):
        key = f"{e['channel_id']}:{e['ts']}"
        names = {str(e.get(k) or "").lstrip("#@").lower() for k in ("channel_id", "channel_name", "author_id", "author")}
        if key in seen or e.get("author_id") == cfg["user"] or names & ignore:
            continue
        seen.add(key)
        e["text"] = str(e.get("text") or "")[:SLACK_TEXT_CAP]
        if filtering and e.get("kind") == "group-dm" and not aimed_at_user(e, cfg, name, active):
            held.append(e)
        elif quiet_event(e, cfg):
            quiet.append(e)
        else:
            fresh.append(e)
    new_seen = (state["seen"] + [f"{e['channel_id']}:{e['ts']}" for e in fresh + held + quiet])[-SLACK_SEEN_CAP:]
    line = None
    if fresh:
        out = events_dir / (started.strftime("%Y%m%dT%H%M%SZ") + ".json")
        write_json(out, {"after": int(after.timestamp()), "polled_at": int(started.timestamp()), "events": fresh})
        line = f"SLACK {len(fresh)} {out}"
    write_json(state_file, {"cursor": int(started.timestamp()), "seen": new_seen,
                            "last_poll": started.strftime("%Y-%m-%dT%H:%M:%SZ"), "last_cost_usd": cost,
                            "user_name": cached})
    if held:  # after the state file, so a failure here never holds a message twice
        append_held(held_path(state_file), held, started)
    if quiet:
        append_held(digest_path(state_file), quiet, started, "quiet_at")
    return line


# ---------- the wait ----------

def error_line(e, secrets=()):
    text = e.stderr if isinstance(e, subprocess.CalledProcessError) and e.stderr else str(e)
    lines = (text or type(e).__name__).strip().splitlines()
    text = lines[0] if lines else type(e).__name__
    for s in secrets:
        if s:
            text = text.replace(s, "***")
    return text


def wait_loop(poll, what, every, max_wait, secrets=()):
    deadline = CLOCK() + max_wait.total_seconds()
    errors = 0
    while True:
        try:
            event = poll()
            errors = 0
        except StopWait as e:  # not fixable by retrying: say so once and stop
            return f"ERROR {e}"
        except Exception as e:  # transient gh or network trouble is retried
            errors += 1
            if errors >= MAX_ERRORS:
                return f"ERROR {error_line(e, secrets)}"
            event = None
        if event:
            return event
        if CLOCK() >= deadline:
            return f"TIMEOUT {what}"
        SLEEP(every.total_seconds())


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--config", default=None,
                        help="config file to read instead of ~/.claude/CLAUDE.md plus ~/.claude/config/*.md")
    common.add_argument("--every", default=None, help="poll interval, like 5m (default 5m)")
    common.add_argument("--max", dest="max_wait", default=None,
                        help="give up after this long (pr 3d, deploy 4h, dagster 12h, slack 12h)")
    p = argparse.ArgumentParser(prog="wait-for", description="Wait for one event, print one line, exit 0. Options go after the mode.")
    sub = p.add_subparsers(dest="mode", required=True)
    pr = sub.add_parser("pr", parents=[common], help="wait for a PR: MERGED CLOSED FAILED CHANGES_REQUESTED HEAD_MOVED CONFLICT BEHIND READY")
    pr.add_argument("repo")
    pr.add_argument("number", type=int)
    pr.add_argument("--sha", help="the approved head; exit HEAD_MOVED when it changes")
    dp = sub.add_parser("deploy", parents=[common], help="wait for a sha to reach prod: DEPLOYED DEPLOY_FAILED")
    dp.add_argument("repo")
    dp.add_argument("sha")
    dg = sub.add_parser("dagster", parents=[common], help="wait for a Dagster run or backfill: SUCCEEDED FAILED")
    dg.add_argument("what", choices=("run", "backfill"))
    dg.add_argument("id")
    sl = sub.add_parser("slack", parents=[common], help="poll Slack for messages aimed at you: SLACK <count> <events file>")
    sl.add_argument("--once", action="store_true", help="poll once and print SLACK ... or NOTHING (setup check)")
    sl.add_argument("--since", help="look back this long instead of from the saved cursor, like 2h")
    return p


def run(args):
    slack = load_slack_config(args.config) if args.mode == "slack" else None
    every = parse_duration(args.every or (slack and slack["every"]) or DEFAULT_EVERY)
    if every < MIN_EVERY:
        raise WaitError("--every must be 10s or more")
    if args.mode == "pr" and args.sha and not re.fullmatch(r"[0-9a-fA-F]{40}", args.sha):
        raise WaitError("--sha must be the full 40-character head sha (gh pr view <n> --json headRefOid -q .headRefOid)")
    max_wait = parse_duration(args.max_wait or DEFAULT_MAX[args.mode])
    secrets = ()
    if args.mode == "pr":
        what = f"pr {args.repo}#{args.number}"
        poll = lambda: poll_pr(args.repo, args.number, args.sha)
    elif args.mode == "deploy":
        cfg = load_config(args.config)
        rule = cfg["deploy_rules"].get(args.repo)
        if not rule:
            raise WaitError(f"no deploy rule for {args.repo} under Deploy rules in the ### Watches config")
        what = f"deploy {args.repo} {args.sha}"
        poll = lambda: poll_deploy(args.repo, args.sha, rule)
    elif args.mode == "slack":
        since = parse_duration(args.since) if args.since else None
        if args.once:
            try:
                line = poll_slack(slack, since) or "NOTHING"
            except Exception as e:
                line = f"ERROR {error_line(e)}"
            print(line, flush=True)
            return 0
        what = "slack"
        first = [since]

        def poll():
            s, first[0] = first[0], None  # --since applies to the first poll only
            return poll_slack(slack, s)
    else:
        dagster = load_config(args.config)["dagster"]
        if not dagster:
            raise WaitError("dagster waits need a `Dagster` line in the ### Watches config")
        load_env_file(dagster["env_file"])
        token = os.environ.get(dagster["token_var"])
        if not token:
            raise WaitError(f"{dagster['token_var']} is not set and not in the env file {dagster['env_file']}")
        what = f"dagster {args.what} {args.id}"
        poll = lambda: poll_dagster(args.what, args.id, dagster, token)
        secrets = (token,)
    print(wait_loop(poll, what, every, max_wait, secrets), flush=True)
    return 0


def main(argv=None):
    try:
        return run(build_parser().parse_args(argv))
    except WaitError as e:
        print(f"wait-for: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
