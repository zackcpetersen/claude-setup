#!/usr/bin/env bash
set -euo pipefail

# query_db - read-only Postgres queries against named databases/environments.
#
# SETUP (see SETUP.md in this repo):
#   1. Edit the DBS and ENVS arrays below to match your databases and environments.
#   2. For each db/env pair, create an env file at ~/bin/env_files/.env.<db>.<env>
#      containing:
#        DATABASE_HOST=...
#        DATABASE_PORT=5432        # optional, defaults to 5432
#        DATABASE_USER=...
#        DATABASE_PASSWORD=...
#        DATABASE_NAME=...
#      Keep env_files out of any git repo - these are credentials.
#   3. All queries run with default_transaction_read_only=on, so writes fail.

ENV_DIR="$HOME/bin/env_files"

# FILL IN: your database names and environment names
DBS=(app warehouse)
ENVS=(dev staging prod)

usage() {
  cat <<EOF
Usage: query_db <db> <env> "<sql>"

  db:   ${DBS[*]}
  env:  ${ENVS[*]}
  sql:  SQL query string (required)

Examples:
  query_db app staging "SELECT count(*) FROM users"
  query_db warehouse prod "SELECT * FROM some_table LIMIT 10"

All queries run in read-only mode.
EOF
  exit 1
}

[[ $# -lt 3 ]] && usage

DB="$1"
ENV="$2"
SQL="$3"

matches() {
  local needle="$1"; shift
  for item in "$@"; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

matches "$DB" "${DBS[@]}" || { echo "Error: db must be one of: ${DBS[*]} (got '$DB')" >&2; exit 1; }
matches "$ENV" "${ENVS[@]}" || { echo "Error: env must be one of: ${ENVS[*]} (got '$ENV')" >&2; exit 1; }

ENV_FILE="$ENV_DIR/.env.$DB.$ENV"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: env file not found: $ENV_FILE" >&2
  echo "Create it with DATABASE_HOST/PORT/USER/PASSWORD/NAME (see setup notes at top of this script)." >&2
  exit 1
fi

set -a
source "$ENV_FILE"
set +a

HOST="$DATABASE_HOST"
PORT="${DATABASE_PORT:-5432}"
USER="$DATABASE_USER"
DBNAME="$DATABASE_NAME"
export PGPASSWORD="$DATABASE_PASSWORD"

# Read-only enforcement
export PGOPTIONS='-c default_transaction_read_only=on'

echo "Connecting to $DB ($ENV) at $HOST..."
psql -h "$HOST" -p "$PORT" -U "$USER" -d "$DBNAME" -c "$SQL"
