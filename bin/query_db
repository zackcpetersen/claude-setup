#!/usr/bin/env bash
set -euo pipefail

# query_db - read-only Postgres queries, credentials supplied per-repo.
#
# Usage: query_db <env-file> "<sql>"
#
#   env-file: path to a file containing:
#               DATABASE_HOST=...
#               DATABASE_PORT=5432        # optional, defaults to 5432
#               DATABASE_USER=...
#               DATABASE_PASSWORD=...
#               DATABASE_NAME=...
#   sql:      SQL query string (required)
#
# Convention: each repo keeps its own env files at the repo root, named
# .env.db.<env> (e.g. .env.db.local, .env.db.cloud). They hold credentials -
# make sure the repo's .gitignore covers them before creating one.
#
# All queries run with default_transaction_read_only=on, so writes fail.

usage() {
  cat <<EOF
Usage: query_db <env-file> "<sql>"

Examples:
  query_db .env.db.local "SELECT count(*) FROM users"
  query_db .env.db.cloud "SELECT * FROM some_table LIMIT 10"

The env file must define DATABASE_HOST, DATABASE_USER, DATABASE_PASSWORD,
DATABASE_NAME (and optionally DATABASE_PORT, default 5432).

All queries run in read-only mode.
EOF
  exit 1
}

[[ $# -lt 2 ]] && usage

ENV_FILE="$1"
SQL="$2"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: env file not found: $ENV_FILE" >&2
  echo "Create it with DATABASE_HOST/PORT/USER/PASSWORD/NAME (see usage notes at top of this script)." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

for var in DATABASE_HOST DATABASE_USER DATABASE_PASSWORD DATABASE_NAME; do
  if [[ -z "${!var:-}" ]]; then
    echo "Error: $var is not set in $ENV_FILE" >&2
    exit 1
  fi
done

HOST="$DATABASE_HOST"
PORT="${DATABASE_PORT:-5432}"
USER="$DATABASE_USER"
DBNAME="$DATABASE_NAME"
export PGPASSWORD="$DATABASE_PASSWORD"

# Read-only enforcement
export PGOPTIONS='-c default_transaction_read_only=on'

# Find psql: PATH first, then Homebrew's keg-only libpq (macOS)
if ! command -v psql >/dev/null 2>&1; then
  for p in /opt/homebrew/opt/libpq/bin /usr/local/opt/libpq/bin; do
    [[ -x "$p/psql" ]] && { PATH="$p:$PATH"; break; }
  done
fi
command -v psql >/dev/null 2>&1 || { echo "Error: psql not found. Install it (e.g. 'brew install libpq')." >&2; exit 1; }

echo "Connecting to $DBNAME at $HOST (via $ENV_FILE)..." >&2
psql -X -v ON_ERROR_STOP=1 -h "$HOST" -p "$PORT" -U "$USER" -d "$DBNAME" -c "$SQL"
