#!/usr/bin/env python3
"""watch: a registry of things we are waiting on.

Owns the registry file and its lock, config parsing, time logic, the tick and
the CLI used by the watch skill. Standard library only. See skills/watch/SKILL.md.
"""

import argparse
import contextlib
import copy
import fcntl
import json
import os
import re
import sys
from datetime import datetime, time, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

KINDS = {
    "slack-thread": {"every": "10m", "slow_every": "60m", "expires": "reply", "connector": "slack", "quiet": True},
    "slack-dm": {"every": "10m", "slow_every": "60m", "expires": "reply", "connector": "slack", "quiet": True},
    "email-thread": {"every": "20m", "slow_every": "60m", "expires": "reply", "connector": "email", "quiet": True},
    "pr": {"every": "15m", "slow_every": "15m", "expires": "until-closed", "connector": None, "quiet": True},
    "deploy": {"every": "30m", "slow_every": "30m", "expires": "two-days", "connector": None, "quiet": True},
    "dagster-run": {"every": "5m", "slow_every": "5m", "expires": "until-terminal", "connector": None, "quiet": False},
    "dagster-backfill": {"every": "5m", "slow_every": "5m", "expires": "until-terminal", "connector": None, "quiet": False},
    "requests-channel": {"every": "10m", "slow_every": "10m", "expires": "never", "connector": "slack", "quiet": True},
}

TARGET_KEYS = {
    "slack-thread": ("channel", "thread_ts"),
    "slack-dm": ("channel",),
    "email-thread": ("thread_id",),
    "pr": ("repo", "number"),
    "deploy": ("repo", "sha"),
    "dagster-run": ("run_id",),
    "dagster-backfill": ("backfill_id",),
    "requests-channel": ("channel", "user"),
}

SLACK_KINDS = {"slack-thread", "slack-dm", "requests-channel"}

STATUSES = ("armed", "fired", "handled", "raised", "expired", "paused", "stopped")
TERMINAL = {"handled", "raised", "expired", "stopped"}

CREATED_BY = ("chat", "board", "pr", "rollover", "script")

SPEC_KEYS = {
    "kind", "target", "expect", "reply_brief", "every", "slow_every", "after", "expires",
    "quiet", "urgent", "on_fire", "created_by", "board_line", "cursor",
}

STALE_TICKS = 3  # list says "tick not running" after this many missed tick intervals
STALE_ERRORS = 3
AGENT_TIMEOUT = timedelta(minutes=10)
FIRED_TIMEOUT = timedelta(minutes=10)
REQUEST_FIRED_TIMEOUT = timedelta(minutes=60)  # a requests-channel watch stays fired while its research agents run
OWNER_WINDOW = 2  # tick intervals
EXPIRY_RULES = {"reply", "two-days", "until-terminal", "until-closed", "never"}
AGENT_NOTE = "detect agent did not report"

DEFAULT_CONFIG = Path("~/.claude/CLAUDE.md")
DEFAULT_REGISTRY = "~/.claude/watches.json"


class WatchError(Exception):
    """A user-facing error. The CLI prints it on one line and exits 2."""


class NotOwner(Exception):
    """Another session ticked recently. The CLI prints it on one line and exits 3."""


def empty_registry():
    return {"version": 1, "owner": None, "last_tick": None, "next_id": 1, "watches": []}


def iso(dt):
    """Store times as UTC ISO 8601."""
    return dt.astimezone(timezone.utc).isoformat()


def parse_iso(text):
    return datetime.fromisoformat(text)


def _aware(text, label):
    """Parse an ISO time that must carry a UTC offset, for spec fields like `after`."""
    try:
        dt = datetime.fromisoformat(str(text))
    except ValueError:
        raise WatchError(f"bad {label} {text!r}, expected ISO 8601 with an offset")
    if dt.tzinfo is None:
        raise WatchError(f"{label} {text!r} needs a UTC offset")
    return dt


# ---------- config ----------

def parse_duration(text):
    m = re.fullmatch(r"\s*(\d+)\s*([smhd])\s*", str(text))
    if not m:
        raise WatchError(f"bad duration {text!r}, expected a number and s, m, h or d (like 5m)")
    n, unit = int(m.group(1)), m.group(2)
    return {"s": timedelta(seconds=n), "m": timedelta(minutes=n), "h": timedelta(hours=n), "d": timedelta(days=n)}[unit]


def parse_deploy_rule(text):
    words = str(text).split()
    if len(words) == 4 and words[0] == "workflow" and words[2] == "on":
        return {"type": "workflow", "name": words[1], "branch": words[3]}
    if words == ["release-tag"]:
        return {"type": "release-tag"}
    if len(words) == 2 and words[0] == "branch":
        return {"type": "branch", "name": words[1]}
    raise WatchError(
        f"bad deploy rule {text!r}, expected `workflow <name> on <branch>`, `release-tag` or `branch <name>`"
    )


def _is_unset(value):
    return value == "" or (value.startswith("<") and value.endswith(">"))


def _clean(value):
    """Strip whitespace and one pair of surrounding backticks (`U123` reads as U123)."""
    value = value.strip()
    if len(value) >= 2 and value.startswith("`") and value.endswith("`"):
        value = value[1:-1].strip()
    return value


def _read_section(lines, heading):
    """Return ({key: value}, {repo: rule text}) for the `### <heading>` section."""
    values, nested = {}, {}
    inside, last_key = False, None
    for raw in lines:
        if raw.startswith("##"):
            inside = raw.startswith("### " + heading)
            last_key = None
            continue
        if not inside:
            continue
        line = re.sub(r"<!--.*?-->", "", raw).rstrip()
        top = re.match(r"^- ([^:]+?):\s*(.*)$", line)
        if top:
            last_key = top.group(1).strip()
            value = _clean(top.group(2))
            if not _is_unset(value):
                values[last_key] = value
            continue
        sub = re.match(r"^\s+- ([^:]+?):\s*(.*)$", line)
        if sub and last_key == "Deploy rules":
            repo, rule = _clean(sub.group(1)), _clean(sub.group(2))
            if not _is_unset(repo) and not _is_unset(rule):
                nested[repo] = rule
    return values, nested


def _parse_window(text, label, with_weekends=False):
    pattern = r"(\d{1,2}:\d{2})-(\d{1,2}:\d{2})"
    if with_weekends:
        pattern += r"(?:;\s*weekends:\s*(quiet|poll))?"
    m = re.fullmatch(pattern, text.strip())
    if not m:
        raise WatchError(f"bad {label} line {text!r}, expected HH:MM-HH:MM")
    out = {"start": time.fromisoformat(m.group(1).zfill(5)), "end": time.fromisoformat(m.group(2).zfill(5))}
    if with_weekends:
        out["weekends"] = (m.group(3) or "quiet") == "quiet"
    return out


def _expand(path):
    return str(Path(path).expanduser())


def load_config(path):
    path = Path(path).expanduser()
    try:
        lines = path.read_text().splitlines()
    except OSError as e:
        raise WatchError(f"cannot read config {path}: {e.strerror}")
    board, _ = _read_section(lines, "Work board")
    watches, rules = _read_section(lines, "Watches")

    if "Time zone" not in watches:
        raise WatchError(f"no `Time zone` line in the ### Watches section of {path}")
    try:
        tz = ZoneInfo(watches["Time zone"])
    except (ZoneInfoNotFoundError, ValueError):
        raise WatchError(f"unknown time zone {watches['Time zone']!r} in {path}")

    self_ids = set()
    slack_id = board.get("Slack user id")
    if slack_id:
        self_ids.add(slack_id)
    email = re.search(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+", board.get("Email", ""))
    if email:
        self_ids.add(email.group(0))

    connectors = {}
    for item in watches.get("Connectors", "").split(","):
        parts = item.split()
        if len(parts) == 2 and not _is_unset(parts[1]):
            connectors[parts[0]] = parts[1]

    requests = None
    if "Requests channel" in watches:
        state_file = board.get("Watch-slack state file")
        if not state_file:
            raise WatchError(f"`Requests channel` is set but the Work board has no `Watch-slack state file` line in {path}")
        if not slack_id:
            raise WatchError(f"`Requests channel` is set but the Work board has no `Slack user id` line in {path}")
        requests = {"channel": watches["Requests channel"], "user": slack_id, "state_file": _expand(state_file)}

    dagster = None
    if "Dagster" in watches:
        m = re.fullmatch(r"(\S+),\s*env file\s+(\S+),\s*token var\s+(\S+)", watches["Dagster"])
        if not m:
            raise WatchError(f"bad Dagster line {watches['Dagster']!r}, expected `<url>, env file <path>, token var <NAME>`")
        dagster = {"url": m.group(1), "env_file": _expand(m.group(2)), "token_var": m.group(3)}

    return {
        "registry": _expand(watches.get("Registry", DEFAULT_REGISTRY)),
        "tz": tz,
        "tick": parse_duration(watches.get("Tick interval", "5m")),
        "quiet": _parse_window(watches.get("Quiet hours", "19:00-08:00; weekends: quiet"), "Quiet hours", with_weekends=True),
        "business": _parse_window(watches.get("Business hours", "08:00-18:00"), "Business hours"),
        "self_ids": self_ids,
        "connectors": connectors,
        "requests": requests,
        "dagster": dagster,
        "deploy_rules": {repo: parse_deploy_rule(rule) for repo, rule in rules.items()},
    }


# ---------- registry ----------

@contextlib.contextmanager
def locked_registry(path, write=True):
    """Hold the registry lock from load to save. Saves only on a clean exit."""
    path = Path(path).expanduser()
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(f"{path}.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if path.exists():
                try:
                    reg = json.loads(path.read_text())
                except ValueError as e:
                    raise WatchError(f"registry {path} is not valid JSON ({e}); fix or move it, it was not changed")
                if not isinstance(reg, dict) or not isinstance(reg.get("watches"), list):
                    raise WatchError(f"registry {path} has no watches list; fix or move it, it was not changed")
            else:
                reg = empty_registry()
            yield reg
            if write:
                tmp = Path(f"{path}.tmp")
                tmp.write_text(json.dumps(reg, indent=2) + "\n")
                os.replace(tmp, path)
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def find_watch(reg, wid):
    for w in reg["watches"]:
        if w["id"] == wid:
            return w
    raise WatchError(f"no watch {wid}")


def _write_state_file(cfg, cursor):
    state_file = Path(cfg["requests"]["state_file"])
    state_file.parent.mkdir(parents=True, exist_ok=True)
    state_file.write_text(f"{cursor}\n")


def _start_cursor(kind, spec, now, cfg):
    if spec.get("cursor") is not None:
        return str(spec["cursor"])
    if kind == "requests-channel":
        try:
            text = Path(cfg["requests"]["state_file"]).read_text().strip()
        except FileNotFoundError:
            text = ""
        return text or f"{now.timestamp():.6f}"
    if kind in SLACK_KINDS:
        return f"{now.timestamp():.6f}"
    if kind == "email-thread":
        raise WatchError("email-thread needs a cursor: the newest message id in the thread")
    return None


def add_watch(reg, spec, now, cfg):
    if not isinstance(spec, dict):
        raise WatchError("a watch spec must be a JSON object")
    unknown = set(spec) - SPEC_KEYS
    if unknown:
        raise WatchError(f"unknown spec keys: {', '.join(sorted(unknown))}")
    kind = spec.get("kind")
    if kind not in KINDS:
        raise WatchError(f"unknown kind {kind!r}, expected one of {', '.join(KINDS)}")
    target = spec.get("target")
    if not isinstance(target, dict):
        raise WatchError(f"{kind} needs a target object")
    missing = [k for k in TARGET_KEYS[kind] if target.get(k) in (None, "")]
    if missing:
        raise WatchError(f"{kind} target is missing {', '.join(missing)}")
    if kind == "requests-channel" and not cfg.get("requests"):
        raise WatchError("requests-channel needs a `Requests channel` line in the ### Watches config")
    created_by = spec.get("created_by", "chat")
    if created_by not in CREATED_BY:
        raise WatchError(f"bad created_by {created_by!r}, expected one of {', '.join(CREATED_BY)}")

    for w in reg["watches"]:
        if w["kind"] == kind and w["target"] == target and w["state"]["status"] not in TERMINAL:
            return w["id"]

    defaults = KINDS[kind]
    every = spec.get("every", defaults["every"])
    slow_every = spec.get("slow_every", defaults["slow_every"])
    parse_duration(every)
    parse_duration(slow_every)
    after = iso(_aware(spec["after"], "after")) if spec.get("after") else None
    expires = spec.get("expires", defaults["expires"])
    if expires not in EXPIRY_RULES:
        expires = iso(_aware(expires, "expires"))
    on_fire = {
        "verify": [],
        "draft": "reply" if kind in ("slack-thread", "slack-dm", "email-thread") else "none",
        "merge": None,
        "then": None,
    }
    on_fire.update(spec.get("on_fire") or {})
    cursor = _start_cursor(kind, spec, now, cfg)
    if kind == "requests-channel":
        _write_state_file(cfg, cursor)

    wid = f"w-{reg['next_id']}"
    reg["next_id"] += 1
    reg["watches"].append({
        "id": wid,
        "kind": kind,
        "target": target,
        "expect": spec.get("expect", ""),
        "reply_brief": spec.get("reply_brief", ""),
        "every": every,
        "slow_every": slow_every,
        "after": after,
        "expires": expires,
        "quiet": spec.get("quiet", defaults["quiet"]),
        "urgent": spec.get("urgent", False),
        "on_fire": on_fire,
        "created": iso(now),
        "created_by": created_by,
        "board_line": spec.get("board_line"),
        "state": {
            "status": "armed",
            "cursor": cursor,
            "last_check": None,
            "last_ok_check": None,
            "checks": 0,
            "errors": 0,
            "note": None,
            "slowed": False,
            "stale_raised": False,
            "dispatched_at": None,
            "fired_at": None,
            "result": None,
            "draft": None,
        },
    })
    return wid


def _ts(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        raise WatchError(f"bad Slack ts {value!r}")


def advance_cursor(kind, old, new):
    """Slack cursors only move forward; other kinds take the new value."""
    if new is None:
        return old
    new = str(new)
    if kind in SLACK_KINDS and old is not None:
        return old if _ts(old) >= _ts(new) else new
    return new


def filter_self(messages, self_ids):
    return [m for m in messages if m.get("author") not in self_ids]


def _fire(state, messages, now):
    if state["status"] == "fired" and state.get("result"):
        state["result"]["messages"].extend(messages)
    else:
        state["status"] = "fired"
        state["fired_at"] = iso(now)
        state["result"] = {"messages": list(messages)}


def _apply_messages(w, messages, now, cfg):
    kind, state = w["kind"], w["state"]
    if not isinstance(messages, list) or not all(isinstance(m, dict) for m in messages):
        raise WatchError("messages must be a list of objects")
    if state["status"] not in ("armed", "fired"):
        # A late report on a paused or finished watch changes nothing, so a
        # reply that lands while paused is seen again after resume.
        return
    cursor = state["cursor"]
    if kind == "requests-channel":
        floor = _ts(cursor) if cursor is not None else float("-inf")
        new = [m for m in messages if m.get("author") == w["target"]["user"] and _ts(m.get("ts")) > floor]
        if new:
            _fire(state, new, now)
        return
    remaining = filter_self(messages, cfg["self_ids"])
    if kind in SLACK_KINDS and cursor is not None:
        remaining = [m for m in remaining if _ts(m.get("ts")) > _ts(cursor)]
    for m in messages:
        cursor = advance_cursor(kind, cursor, m.get("ts") if kind in SLACK_KINDS else m.get("id"))
    state["cursor"] = cursor
    if remaining:
        _fire(state, remaining, now)


def update_watch(reg, wid, now, cfg, *, status=None, cursor=None, checked=False, error=None, note=None,
                 draft=None, messages=None, merge=None, head=None, board_line=None):
    w = find_watch(reg, wid)
    state = w["state"]
    if merge is not None or head is not None:
        if w["kind"] != "pr":
            raise WatchError(f"{wid} is a {w['kind']} watch; only pr watches take a merge approval")
        if merge is None or head is None:
            raise WatchError("a merge approval needs both the user's words and the PR head sha")
    if status is not None:
        if status not in STATUSES:
            raise WatchError(f"bad status {status!r}, expected one of {', '.join(STATUSES)}")
        state["status"] = status
    if cursor is not None:
        state["cursor"] = advance_cursor(w["kind"], state["cursor"], cursor)
        if w["kind"] == "requests-channel" and cfg.get("requests"):
            _write_state_file(cfg, state["cursor"])
    if checked:
        state["last_check"] = state["last_ok_check"] = iso(now)
        state["checks"] += 1
        state["errors"] = 0
        state["dispatched_at"] = None
        state["stale_raised"] = False
    if error is not None:
        state["last_check"] = iso(now)
        state["errors"] += 1
        state["note"] = error
    if note is not None:
        state["note"] = note
    if draft is not None:
        state["draft"] = draft
    if messages is not None:
        _apply_messages(w, messages, now, cfg)
    if merge is not None:
        w["on_fire"]["merge"] = {"words": merge, "at": iso(now), "head_sha": head}
    if board_line is not None:
        w["board_line"] = board_line
    return w


# ---------- time ----------

def _in_window(t, window):
    start, end = window["start"], window["end"]
    if start <= end:
        return start <= t < end
    return t >= start or t < end


def in_quiet_hours(now, cfg):
    local = now.astimezone(cfg["tz"])
    if cfg["quiet"]["weekends"] and local.weekday() >= 5:
        return True
    return _in_window(local.time(), cfg["quiet"])


def _next_weekday(day):
    day += timedelta(days=1)
    while day.weekday() >= 5:
        day += timedelta(days=1)
    return day


def add_business_days(start, n, cfg):
    """Move to the next moment inside business hours, then step n weekdays at the same wall time."""
    tz, bstart, bend = cfg["tz"], cfg["business"]["start"], cfg["business"]["end"]
    local = start.astimezone(tz)
    day, wall = local.date(), local.time().replace(tzinfo=None)
    if day.weekday() >= 5 or wall >= bend:
        day, wall = _next_weekday(day), bstart
    elif wall < bstart:
        wall = bstart
    for _ in range(n):
        day = _next_weekday(day)
    return datetime.combine(day, wall, tzinfo=tz)


def expiry_state(watch, now, cfg):
    rule = watch["expires"]
    created = parse_iso(watch["created"])
    if rule == "reply":
        if now >= add_business_days(created, 5, cfg):
            return "hard"
        if now >= add_business_days(created, 1, cfg):
            return "soft"
        return None
    if rule == "two-days":
        return "hard" if now - created >= timedelta(hours=48) else None
    if rule == "until-terminal":
        hours = watch["target"].get("expected_hours")
        if hours is not None and now - created > timedelta(hours=float(hours)):
            return "soft"
        return None
    if rule in ("until-closed", "never"):
        return None
    return "hard" if now >= parse_iso(rule) else None


def cadence(watch):
    return parse_duration(watch["slow_every"] if watch["state"].get("slowed") else watch["every"])


def is_due(watch, now, cfg):
    state = watch["state"]
    if state["status"] != "armed":
        return False
    if watch.get("quiet") and in_quiet_hours(now, cfg):
        return False
    if watch.get("after") and now < parse_iso(watch["after"]):
        return False
    if state.get("dispatched_at"):
        return False
    return not state.get("last_check") or now - parse_iso(state["last_check"]) >= cadence(watch)


def _agent_overdue(state, now):
    return bool(state.get("dispatched_at")) and now - parse_iso(state["dispatched_at"]) > AGENT_TIMEOUT


def _errors_reason(state):
    if state.get("errors", 0) >= STALE_ERRORS:
        return f"{STALE_ERRORS} failed checks in a row: {state.get('note')}"
    return None


def _late_reason(watch, now):
    state = watch["state"]
    if _agent_overdue(state, now):
        return AGENT_NOTE
    if state["status"] == "fired" and state.get("fired_at"):
        limit = REQUEST_FIRED_TIMEOUT if watch["kind"] == "requests-channel" else FIRED_TIMEOUT
        if now - parse_iso(state["fired_at"]) > limit:
            return "fired but not handled"
    return None


def stale_reason(watch, now):
    """Counted in failed checks and silent agents, never in elapsed wall time."""
    return _errors_reason(watch["state"]) or _late_reason(watch, now)


# ---------- checks ----------

def run_check(watch, cfg):
    """Run one script-backed check. Returns (fingerprint, event or None, result); raises on failure."""
    raise NotImplementedError(f"no script check for {watch['kind']} yet")


def short_error(e, cfg):
    message = str(e)
    dagster = cfg.get("dagster")
    token = os.environ.get(dagster["token_var"]) if dagster else None
    if token:
        message = message.replace(token, "***")
    return f"{type(e).__name__}: {message[:120]}"


# ---------- tick ----------

def _raise_stale(w, reason, report):
    if reason and not w["state"].get("stale_raised"):
        w["state"]["stale_raised"] = True
        report["stale"].append({"id": w["id"], "reason": reason})


def _tick_watch(reg, w, cfg, now, report, woke):
    state = w["state"]
    phase = expiry_state(w, now, cfg)
    if phase == "hard":
        state["status"] = "expired"
        report["expired"].append({"id": w["id"], "rule": w["expires"], "phase": "hard"})
        return
    if phase == "soft" and not state.get("slowed"):
        state["slowed"] = True
        report["expired"].append({"id": w["id"], "rule": w["expires"], "phase": "soft"})

    if woke and state.get("dispatched_at"):
        # The agent ran into a sleep or a closed session, not a fault: just check again.
        state["dispatched_at"] = None
    reason = _late_reason(w, now)
    if _agent_overdue(state, now):
        # Count the silent agent as a failed check so it is dispatched again next cadence.
        state["dispatched_at"] = None
        update_watch(reg, w["id"], now, cfg, error=AGENT_NOTE)
    _raise_stale(w, reason, report)

    if state["status"] == "fired" or not is_due(w, now, cfg):
        return
    connector = KINDS[w["kind"]]["connector"]
    if connector:
        state["dispatched_at"] = iso(now)
        report["due"][connector].append({"id": w["id"], "kind": w["kind"], "target": w["target"], "cursor": state["cursor"]})
        return
    try:
        fp, event, result = run_check(w, cfg)
    except Exception as e:
        update_watch(reg, w["id"], now, cfg, error=short_error(e, cfg))
        return
    update_watch(reg, w["id"], now, cfg, checked=True)
    if event and fp != state["cursor"]:
        state["status"] = "fired"
        state["fired_at"] = iso(now)
        state["result"] = result
        report["fired"].append({
            "id": w["id"], "kind": w["kind"], "event": event, "result": result, "target": w["target"],
            "expect": w.get("expect"), "reply_brief": w.get("reply_brief"), "on_fire": w.get("on_fire"),
            "urgent": bool(w.get("urgent") or (result or {}).get("urgent", False)), "board_line": w.get("board_line"),
        })
    state["cursor"] = fp


def tick(reg, cfg, now, *, session, take=False):
    owner, last_tick = reg.get("owner"), reg.get("last_tick")
    if owner and owner != session and not take and last_tick \
            and now - parse_iso(last_tick) < OWNER_WINDOW * cfg["tick"]:
        raise NotOwner(f"tick refused: owned by {owner}, last tick {_hhmm(last_tick, cfg['tz'])}")
    woke = bool(last_tick) and now - parse_iso(last_tick) > OWNER_WINDOW * cfg["tick"]
    reg["owner"], reg["last_tick"] = session, iso(now)
    report = {"fired": [], "due": {"slack": [], "email": []}, "stale": [], "expired": []}
    for w in reg["watches"]:
        if w["state"]["status"] in TERMINAL:
            continue
        _tick_watch(reg, w, cfg, now, report, woke)
        if w["state"]["status"] not in TERMINAL:
            # After the check, so the third failure raises on the same tick.
            _raise_stale(w, _errors_reason(w["state"]), report)
    return report


def has_news(report):
    return bool(report["fired"] or report["due"]["slack"] or report["due"]["email"] or report["stale"] or report["expired"])


# ---------- list ----------

def _hhmm(text_or_dt, tz):
    dt = parse_iso(text_or_dt) if isinstance(text_or_dt, str) else text_or_dt
    return dt.astimezone(tz).strftime("%H:%M")


def next_check(w, now):
    state = w["state"]
    every = parse_duration(w["slow_every"] if state.get("slowed") else w["every"])
    nxt = parse_iso(state["last_check"]) + every if state.get("last_check") else now
    if w.get("after"):
        nxt = max(nxt, parse_iso(w["after"]))
    return max(nxt, now)


def format_list(reg, cfg, now):
    tz = cfg["tz"]
    lines = []
    for w in reg["watches"]:
        state = w["state"]
        if state["status"] in TERMINAL:
            continue
        last_ok = _hhmm(state["last_ok_check"], tz) if state.get("last_ok_check") else "never"
        expect = (w.get("expect") or "")[:60]
        lines.append(
            f'{w["id"]} {w["kind"]} {state["status"]} next {_hhmm(next_check(w, now), tz)} last ok {last_ok} "{expect}"'
        )
    if not lines:
        lines.append("no open watches")
    if reg.get("last_tick"):
        lines.append(f"tick: last {_hhmm(reg['last_tick'], tz)} by {reg.get('owner') or 'unknown'}")
        running = now - parse_iso(reg["last_tick"]) <= STALE_TICKS * cfg["tick"]
    else:
        lines.append("tick: never")
        running = False
    if not running:
        lines.append("tick not running")
    return "\n".join(lines)


# ---------- CLI ----------

def _read_json(text, where):
    try:
        return json.loads(text)
    except ValueError as e:
        raise WatchError(f"{where} is not valid JSON: {e}")


def _parse_now(text):
    try:
        now = datetime.fromisoformat(text)
    except ValueError:
        raise WatchError(f"bad --now {text!r}, expected ISO 8601 with an offset")
    if now.tzinfo is None:
        raise WatchError(f"--now {text!r} needs a UTC offset")
    return now


def build_parser():
    p = argparse.ArgumentParser(prog="watch", description="Registry of things we are waiting on.")
    p.add_argument("--registry", help="registry file (env WATCH_REGISTRY; default from config)")
    p.add_argument("--config", help="config file (env WATCH_CONFIG; default ~/.claude/CLAUDE.md)")
    p.add_argument("--now", help="current time, ISO 8601 with offset (env WATCH_NOW; for tests)")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="add a watch from a JSON spec (stdin when no flag)")
    src = a.add_mutually_exclusive_group()
    src.add_argument("--file")
    src.add_argument("--json")

    sub.add_parser("list", help="one line per open watch")
    s = sub.add_parser("status", help="JSON for one watch, or the whole registry")
    s.add_argument("id", nargs="?")
    st = sub.add_parser("stop", help="stop one watch")
    st.add_argument("id")
    sub.add_parser("pause", help="pause every armed watch")
    sub.add_parser("resume", help="re-arm every paused watch")

    u = sub.add_parser("update", help="record a check, a fire, a cursor or a status")
    u.add_argument("id")
    u.add_argument("--status", choices=STATUSES)
    u.add_argument("--cursor")
    u.add_argument("--checked", action="store_true")
    u.add_argument("--error")
    u.add_argument("--note")
    u.add_argument("--draft")
    u.add_argument("--messages-file")
    u.add_argument("--merge")
    u.add_argument("--head")
    u.add_argument("--board-line")

    t = sub.add_parser("tick", help="check due watches; prints one JSON line only when there is news")
    t.add_argument("--take", action="store_true", help="tick even if another session owns the tick")
    t.add_argument("--session", default="default", help="this session's name, recorded as the tick owner")
    return p


def run(args):
    now = _parse_now(args.now or os.environ["WATCH_NOW"]) if (args.now or os.environ.get("WATCH_NOW")) \
        else datetime.now(timezone.utc)
    cfg = load_config(Path(args.config or os.environ.get("WATCH_CONFIG") or DEFAULT_CONFIG).expanduser())
    registry = Path(args.registry or os.environ.get("WATCH_REGISTRY") or cfg["registry"]).expanduser()

    if args.cmd == "add":
        if args.file:
            try:
                text = Path(args.file).read_text()
            except OSError as e:
                raise WatchError(f"cannot read {args.file}: {e.strerror}")
        elif args.json is not None:
            text = args.json
        else:
            text = sys.stdin.read()
        spec = _read_json(text, "the watch spec")
        with locked_registry(registry) as reg:
            print(add_watch(reg, spec, now, cfg))
    elif args.cmd == "list":
        with locked_registry(registry, write=False) as reg:
            print(format_list(reg, cfg, now))
    elif args.cmd == "status":
        with locked_registry(registry, write=False) as reg:
            print(json.dumps(find_watch(reg, args.id) if args.id else reg, indent=2))
    elif args.cmd == "stop":
        with locked_registry(registry) as reg:
            update_watch(reg, args.id, now, cfg, status="stopped")
            print(f"{args.id} stopped")
    elif args.cmd in ("pause", "resume"):
        old, new = ("armed", "paused") if args.cmd == "pause" else ("paused", "armed")
        with locked_registry(registry) as reg:
            ids = [w["id"] for w in reg["watches"] if w["state"]["status"] == old]
            for wid in ids:
                update_watch(reg, wid, now, cfg, status=new)
            print(f"{new}: {', '.join(ids) if ids else 'none'}")
    elif args.cmd == "update":
        messages = None
        if args.messages_file:
            try:
                messages = _read_json(Path(args.messages_file).read_text(), args.messages_file)
            except OSError as e:
                raise WatchError(f"cannot read {args.messages_file}: {e.strerror}")
        with locked_registry(registry) as reg:
            w = update_watch(
                reg, args.id, now, cfg, status=args.status, cursor=args.cursor, checked=args.checked,
                error=args.error, note=args.note, draft=args.draft, messages=messages, merge=args.merge,
                head=args.head, board_line=args.board_line,
            )
            print(f"{w['id']} {w['state']['status']}")
    elif args.cmd == "tick":
        with locked_registry(registry) as reg:
            report = tick(reg, cfg, now, session=args.session, take=args.take)
        if has_news(report):
            print(json.dumps(report, separators=(",", ":")))
    return 0


def main(argv):
    args = build_parser().parse_args(argv)
    try:
        return run(args)
    except WatchError as e:
        print(f"watch: {e}", file=sys.stderr)
        return 2
    except NotOwner as e:
        print(e, file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
